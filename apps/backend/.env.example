# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aprint"

# Secret used to sign JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change_this_secret"
JWT_EXPIRES_IN="8h"

PORT=5001
NODE_ENV=development

# Origins allowed to call this API (comma-separated, no trailing slash, no
# wildcard in production). In production these must be the REAL deployed
# Vercel URLs for apps/client and apps/admin — e.g.:
#   CLIENT_URL="https://your-client.vercel.app,https://your-custom-domain.com"
#   ADMIN_URL="https://your-admin.vercel.app"
# A mismatch here (still pointing at localhost, or missing a domain the app
# is actually served from) is a common cause of "login works locally but
# not in production" — the browser's CORS preflight gets rejected.
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:5178"

# Used only by prisma/seed.ts to create the first admin LOGIN account
# (unrelated to ADMIN_EMAIL below — that's the contact-notification inbox).
SEED_ADMIN_NAME="A Print Admin"
SEED_ADMIN_EMAIL="admin@aprint.local"
SEED_ADMIN_PASSWORD="change_this_password"

# Self-service admin registration (POST /api/auth/register, used by
# apps/admin's /admin/register page). Enabled by default. Set to "false"
# once your team's admin accounts exist, to close public sign-up.
REGISTRATION_ENABLED=true

# --- Contact form email notifications (see src/services/email.service.ts) ---
# SMTP credentials for the account contact-form notifications are SENT FROM.
# Mail.ru: host smtp.mail.ru, port 465 (SSL). MAIL_PASSWORD must be an
# app password, not your regular mailbox password — see README.md.
MAIL_HOST="smtp.mail.ru"
MAIL_PORT=465
MAIL_USER="your-account@mail.ru"
MAIL_PASSWORD="your-mail.ru-app-password"
MAIL_FROM="your-account@mail.ru"

# The business inbox that receives every contact-form submission.
ADMIN_EMAIL="asadov_78@mail.ru"

# --- Portfolio image storage (see src/services/storage.service.ts) ---
# Optional. When set, admin-uploaded portfolio images are stored in Vercel
# Blob (persistent, works on serverless/ephemeral hosts) instead of the
# local ./uploads/portfolio disk folder, which does NOT survive a redeploy
# on most serverless/PaaS platforms. Create a Blob store in the Vercel
# dashboard (or `vercel blob store add`) and paste its token here — never
# commit a real token, and never expose it to the client/admin frontends.
BLOB_READ_WRITE_TOKEN=
