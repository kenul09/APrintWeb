# Example environment variables for local development

# apps/backend REST API (see apps/backend/README.md). Used by lib/api/* for
# products, portfolio and the contact form. Must include the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Admin app URL used by the "Admin Giriş" button (components/layout/AdminLoginButton.jsx).
# - In development, leave this unset to use the apps/admin Vite dev server
#   (http://localhost:5178, per apps/admin/vite.config.js). Start it with
#   `npm run dev:admin` from the repo root (or `cd apps/admin && npm run dev`).
#   `npm run dev` from the repo root starts both client and admin together.
# - In production, this MUST be set to the deployed admin app's Vercel URL,
#   otherwise the Admin Giriş button is hidden (there is no localhost fallback in production).
NEXT_PUBLIC_ADMIN_URL=https://YOUR-ADMIN-VERCEL-DOMAIN.vercel.app

# Legacy: still used by the handful of Next.js API routes (app/api/orders,
# app/api/customers, app/api/auth/register) that were NOT migrated to
# apps/backend. Products, portfolio, contact and the primary admin login now
# go through apps/backend/.env instead — see that app's README.
DATABASE_URL="file:./dev.db"

# Admin session auth — server-only, never expose these with a NEXT_PUBLIC_ prefix.
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "require('bcryptjs').hash('yourpassword', 10).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Origin the admin SPA is served from, used for CORS on the API routes it calls.
ADMIN_ORIGIN=https://YOUR-ADMIN-VERCEL-DOMAIN.vercel.app
