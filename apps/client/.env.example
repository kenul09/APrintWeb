# Example environment variables for local development
# Admin app URL (Vercel domain) - optional. If not provided, the Admin Giriş link will be hidden.
VITE_ADMIN_URL=https://YOUR-ADMIN-VERCEL-DOMAIN.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://YOUR-ADMIN-VERCEL-DOMAIN.vercel.app

# Shared SQLite database used by the Prisma-backed API routes (app/api/**).
DATABASE_URL="file:./dev.db"

# Admin session auth — server-only, never expose these with a NEXT_PUBLIC_ prefix.
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "require('bcryptjs').hash('yourpassword', 10).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Origin the admin SPA is served from, used for CORS on the API routes it calls.
ADMIN_ORIGIN=https://YOUR-ADMIN-VERCEL-DOMAIN.vercel.app
