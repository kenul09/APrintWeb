# URL of the apps/client Next.js app. Only the legacy orders/customers pages
# and the admin-registration screen still call this — everything else has
# moved to apps/backend (see VITE_BACKEND_URL below).
VITE_API_URL=https://YOUR-CLIENT-VERCEL-DOMAIN.vercel.app

# apps/backend REST API (see apps/backend/README.md). Used for admin login,
# products, portfolio and contact messages. Must include the /api prefix.
VITE_BACKEND_URL=http://localhost:5001/api
